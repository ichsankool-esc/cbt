generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model academic_years {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String              @db.Uuid
  name              String
  is_active         Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  schools           schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  class_enrollments class_enrollments[]
  classes           classes[]
  semesters         semesters[]
}

model app_settings {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id String  @db.Uuid
  key       String
  value     Json    @default("{}")
  schools   schools @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, key])
}

model attempt_answers {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id          String        @db.Uuid
  question_id         String        @db.Uuid
  selected_option_ids Json          @default("[]")
  essay_text          String?
  is_correct          Boolean?
  points_awarded      Decimal?      @db.Decimal(6, 2)
  is_flagged          Boolean       @default(false)
  answered_at         DateTime      @default(now()) @db.Timestamptz(6)
  time_spent_seconds  Int           @default(0)
  exam_attempts       exam_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions           questions     @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attempt_id, question_id])
  @@index([attempt_id], map: "idx_answers_attempt")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String?  @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String?
  entity_id   String?  @db.Uuid
  metadata    Json     @default("{}")
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  schools     schools? @relation(fields: [school_id], references: [id], onUpdate: NoAction)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([school_id, created_at(sort: Desc)], map: "idx_audit_school_created")
}

model class_enrollments {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id         String          @db.Uuid
  student_id       String          @db.Uuid
  academic_year_id String?         @db.Uuid
  academic_years   academic_years? @relation(fields: [academic_year_id], references: [id], onUpdate: NoAction)
  classes          classes         @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users           @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([class_id, student_id])
}

model classes {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String              @db.Uuid
  academic_year_id    String?             @db.Uuid
  name                String
  grade_level         Int?
  homeroom_teacher_id String?             @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  class_enrollments   class_enrollments[]
  academic_years      academic_years?     @relation(fields: [academic_year_id], references: [id], onUpdate: NoAction)
  users               users?              @relation(fields: [homeroom_teacher_id], references: [id], onUpdate: NoAction)
  schools             schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_assignments    exam_assignments[]
}

model exam_assignments {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id         String         @db.Uuid
  exam_session_id String?        @db.Uuid
  class_id        String?        @db.Uuid
  student_id      String?        @db.Uuid
  token           String?
  classes         classes?       @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exams           exams          @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_sessions   exam_sessions? @relation(fields: [exam_session_id], references: [id], onUpdate: NoAction)
  users           users?         @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exam_attempts {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id            String            @db.Uuid
  student_id         String            @db.Uuid
  exam_session_id    String?           @db.Uuid
  attempt_number     Int               @default(1)
  status             attempt_status    @default(in_progress)
  started_at         DateTime          @default(now()) @db.Timestamptz(6)
  submitted_at       DateTime?         @db.Timestamptz(6)
  time_spent_seconds Int               @default(0)
  current_index      Int               @default(0)
  score              Decimal?          @db.Decimal(8, 2)
  total_points       Decimal?          @db.Decimal(8, 2)
  ip_address         String?           @db.Inet
  user_agent         String?
  attempt_answers    attempt_answers[]
  exams              exams             @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_sessions      exam_sessions?    @relation(fields: [exam_session_id], references: [id], onUpdate: NoAction)
  users              users             @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_results       exam_results[]
  proctor_events     proctor_events[]

  @@unique([exam_id, student_id, attempt_number])
  @@index([exam_id], map: "idx_attempts_active", where: raw("(status = 'in_progress'::attempt_status)"))
  @@index([exam_id, student_id], map: "idx_attempts_exam_student")
}

model exam_questions {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id         String    @db.Uuid
  question_id     String    @db.Uuid
  order_index     Int       @default(0)
  points_override Decimal?  @db.Decimal(6, 2)
  exams           exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions       questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_id, question_id])
}

model exam_results {
  id                                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id                              String         @db.Uuid
  student_id                           String         @db.Uuid
  attempt_id                           String?        @db.Uuid
  score                                Decimal?       @db.Decimal(8, 2)
  grade                                String?
  rank                                 Int?
  is_published                         Boolean        @default(false)
  graded_by                            String?        @db.Uuid
  graded_at                            DateTime?      @db.Timestamptz(6)
  exam_attempts                        exam_attempts? @relation(fields: [attempt_id], references: [id], onUpdate: NoAction)
  exams                                exams          @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_exam_results_graded_byTousers  users?         @relation("exam_results_graded_byTousers", fields: [graded_by], references: [id], onUpdate: NoAction)
  users_exam_results_student_idTousers users          @relation("exam_results_student_idTousers", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_id, student_id])
}

model exam_sessions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id          String             @db.Uuid
  name             String
  start_at         DateTime?          @db.Timestamptz(6)
  end_at           DateTime?          @db.Timestamptz(6)
  room             String?
  exam_assignments exam_assignments[]
  exam_attempts    exam_attempts[]
  exams            exams              @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exams {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id               String             @db.Uuid
  subject_id              String?            @db.Uuid
  semester_id             String?            @db.Uuid
  created_by              String?            @db.Uuid
  title                   String
  description             String?
  exam_type               exam_type          @default(uts)
  duration_minutes        Int                @default(60)
  total_points            Decimal            @default(0) @db.Decimal(8, 2)
  passing_score           Decimal?           @db.Decimal(6, 2)
  shuffle_questions       Boolean            @default(true)
  shuffle_options         Boolean            @default(true)
  show_result_immediately Boolean            @default(true)
  max_attempts            Int                @default(1)
  status                  exam_status        @default(draft)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at              DateTime?          @db.Timestamptz(6)
  exam_assignments        exam_assignments[]
  exam_attempts           exam_attempts[]
  exam_questions          exam_questions[]
  exam_results            exam_results[]
  exam_sessions           exam_sessions[]
  users                   users?             @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  schools                 schools            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  semesters               semesters?         @relation(fields: [semester_id], references: [id], onUpdate: NoAction)
  subjects                subjects?          @relation(fields: [subject_id], references: [id], onUpdate: NoAction)

  @@index([school_id, status], map: "idx_exams_school_status", where: raw("(deleted_at IS NULL)"))
}

model proctor_events {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id    String        @db.Uuid
  event_type    proctor_event
  metadata      Json          @default("{}")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  exam_attempts exam_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attempt_id], map: "idx_proctor_attempt")
}

model question_banks {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String      @db.Uuid
  subject_id       String?     @db.Uuid
  owner_teacher_id String?     @db.Uuid
  name             String
  description      String?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  users            users?      @relation(fields: [owner_teacher_id], references: [id], onUpdate: NoAction)
  schools          schools     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects         subjects?   @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  questions        questions[]
}

model question_options {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String    @db.Uuid
  label       String?
  content     String
  is_correct  Boolean   @default(false)
  order_index Int       @default(0)
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "idx_options_question")
}

model question_tags {
  question_id String    @db.Uuid
  tag_id      String    @db.Uuid
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags        tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([question_id, tag_id])
}

model questions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_bank_id String             @db.Uuid
  subject_id       String?            @db.Uuid
  type             question_type      @default(single_choice)
  difficulty       difficulty_level   @default(medium)
  content          String
  media_url        String?
  default_points   Decimal            @default(1) @db.Decimal(6, 2)
  explanation      String?
  version          Int                @default(1)
  status           content_status     @default(draft)
  created_by       String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  attempt_answers  attempt_answers[]
  exam_questions   exam_questions[]
  question_options question_options[]
  question_tags    question_tags[]
  users            users?             @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  question_banks   question_banks     @relation(fields: [question_bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects         subjects?          @relation(fields: [subject_id], references: [id], onUpdate: NoAction)

  @@index([question_bank_id], map: "idx_questions_bank", where: raw("(deleted_at IS NULL)"))
}

model schools {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  npsn           String?          @unique
  address        String?
  logo_url       String?
  timezone       String           @default("Asia/Jakarta")
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  academic_years academic_years[]
  app_settings   app_settings[]
  audit_logs     audit_logs[]
  classes        classes[]
  exams          exams[]
  question_banks question_banks[]
  subjects       subjects[]
  tags           tags[]
  users          users[]
}

model semesters {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academic_year_id String         @db.Uuid
  name             String
  is_active        Boolean        @default(false)
  exams            exams[]
  academic_years   academic_years @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model student_profiles {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String  @unique @db.Uuid
  nis        String?
  nisn       String?
  gender     String?
  entry_year Int?
  photo_url  String?
  users      users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subjects {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id      String           @db.Uuid
  code           String
  name           String
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  exams          exams[]
  question_banks question_banks[]
  questions      questions[]
  schools        schools          @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, code])
}

model tags {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String          @db.Uuid
  name          String
  question_tags question_tags[]
  schools       schools         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, name])
}

model teacher_profiles {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String  @unique @db.Uuid
  nip      String?
  position String?
  users    users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                                   String?             @db.Uuid
  full_name                                   String
  email                                       String?
  username                                    String
  password_hash                               String
  role                                        user_role           @default(student)
  status                                      user_status         @default(active)
  last_login_at                               DateTime?           @db.Timestamptz(6)
  created_at                                  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                                  DateTime?           @db.Timestamptz(6)
  audit_logs                                  audit_logs[]
  class_enrollments                           class_enrollments[]
  classes                                     classes[]
  exam_assignments                            exam_assignments[]
  exam_attempts                               exam_attempts[]
  exam_results_exam_results_graded_byTousers  exam_results[]      @relation("exam_results_graded_byTousers")
  exam_results_exam_results_student_idTousers exam_results[]      @relation("exam_results_student_idTousers")
  exams                                       exams[]
  question_banks                              question_banks[]
  questions                                   questions[]
  student_profiles                            student_profiles?
  teacher_profiles                            teacher_profiles?
  schools                                     schools?            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([school_id, username])
  @@index([school_id, role], map: "idx_users_school_role", where: raw("(deleted_at IS NULL)"))
}

enum attempt_status {
  in_progress
  submitted
  auto_submitted
  graded
}

enum content_status {
  draft
  published
  archived
}

enum difficulty_level {
  easy
  medium
  hard
}

enum exam_status {
  draft
  scheduled
  active
  closed
  archived
}

enum exam_type {
  uts
  uas
  quiz
}

enum proctor_event {
  tab_blur
  fullscreen_exit
  paste
  focus_lost
  reconnect
  other
}

enum question_type {
  single_choice
  multiple_answer
  true_false
  essay
  matching
}

enum user_role {
  superadmin
  admin
  teacher
  student
  proctor
}

enum user_status {
  active
  inactive
  suspended
}
